{
  "name": "@storybook/archetypes",
  "label": "Правила структуры проектов",
  "version": "0.0.0",
  "private": true,
  "description": "Исполняемый стандарт Project, Repo, Domain и Component на единой структуре Package",
  "exports": {
    ".": "./index.ts",
    "./project": "./project/index.ts",
    "./package": "./package/index.ts",
    "./repo": "./repo/index.ts",
    "./domain": "./domain/index.ts",
    "./component": "./component/index.ts",
    "./specs": "./specs/index.ts",
    "./package/package-json": "./package/package-json/index.ts",
    "./package/index": "./package/index/index.ts",
    "./package/documentation": "./package/documentation/index.ts",
    "./specs/scenarios": "./specs/scenarios/index.ts",
    "./specs/scenarios/validation": "./specs/scenarios/validation/index.ts",
    "./specs/guide": "./specs/guide/index.ts"
  },
  "scripts": {
    "test": "bun test --path-ignore-patterns **/fixture/** --max-concurrency=1"
  }
}
