{
  "name": "@archetypes/specs",
  "label": "Спецификации",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Зависимости, контракты, сценарии и фикстуры спецификаций",
  "scripts": {
    "test:spec:repository": "bun test ./spec --test-name-pattern '^Репозиторий(?: |$)'",
    "test:spec:package": "bun test ./spec --test-name-pattern '^Пакет(?: |$)'",
    "test:spec:category": "bun test ./spec --test-name-pattern '^Категория(?: |$)'",
    "test:spec:entity": "bun test ./spec --test-name-pattern '^Сущность(?: |$)'"
  },
  "exports": {
    ".": "./index.ts"
  },
  "dependencies": {
    "@storybook/app": "workspace:../../app",
    "@archetypes/scenario-guide": "workspace:*",
    "@archetypes/scenario-document": "workspace:*"
  },
  "workspaces": [
    "scenarios",
    "guide"
  ]
}
