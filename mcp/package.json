{
  "name": "@zavx0z/storybook-mcp",
  "label": "Инструменты Storybook MCP",
  "description": "Предоставляет агенту навигацию, управление и диагностику единого сервера Storybook через MCP.",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./proxy": "./proxy/index.ts",
    "./server": "./server/index.ts"
  },
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "rest",
    "address",
    "children",
    "root"
  ],
  "scripts": {
    "start": "bun run stdio.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit --pretty false",
    "check": "bun run typecheck && bun run test"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@mcp/address": "workspace:*",
    "@archetypes/specs": "workspace:*",
    "@storybook/route": "workspace:*",
    "@mcp/rest": "workspace:*",
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/bun": "^1.4.0",
    "typescript": "^7.0.2",
    "@mcp/children": "workspace:*",
    "@mcp/root": "workspace:*"
  }
}
