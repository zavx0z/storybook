                      ],
                      "unchecked": [],
                    },
                    "packageJson": {
                      "dependencies": {
                        "@archetypes/package-documentation": "workspace:*",
                        "@archetypes/package-index": "workspace:*",
                        "@archetypes/package-json": "workspace:*",
                        "@storybook/route": "workspace:*",
                        "typescript": "^7.0.2",
                      },
                      "description": "Объясняет и проверяет назначение пакета, принадлежность публичных входов и наличие их контрактов",
                      "exports": {
                        ".": "./index.ts",
                      },
                      "label": "Пакет",
                      "name": "@archetypes/package",
