{
  "name": "@zavx0z/storybook",
  "version": "0.0.0",
  "private": true,
  "description": "One external declaration-driven Storybook server for independently owned packages.",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "storybook": "./scripts/storybook.ts"
  },
  "scripts": {
    "storybook": "bun scripts/storybook.ts",
    "serve": "bun scripts/storybook.ts serve .",
    "build": "bun scripts/storybook.ts check .",
    "typecheck": "tsc --noEmit --pretty false",
    "browser-lifecycle:check": "bun run --cwd packages/browser-lifecycle check",
    "test": "STORYBOOK_SKIP_ISOLATION=1 bun test src --max-concurrency=1 && bun test src/external/isolation.integration.test.ts --max-concurrency=1",
    "mcp:check": "bun run --cwd mcp check",
    "check": "bun run browser-lifecycle:check && bun run typecheck && bun run test && bun run mcp:check && bun run build"
  },
  "dependencies": {
    "@zavx0z/storybook-browser-lifecycle": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@webgpu/types": "^0.1.68",
    "@zavx0z/browser": "file:../webxr-space/browser",
    "@zavx0z/component": "file:../webxr-space/component",
    "@zavx0z/dom": "file:../webxr-space/dom",
    "@zavx0z/devtools": "file:../webxr-space/devtools",
    "@zavx0z/engine": "file:../webxr-space/engine",
    "@zavx0z/highlighter": "link:@zavx0z/highlighter",
    "@zavx0z/layout": "file:../webxr-space/layout",
    "@zavx0z/nodes": "file:../webxr-space/nodes",
    "@zavx0z/nodetree": "file:../webxr-space/nodetree",
    "@zavx0z/renderer": "file:../webxr-space/renderer",
    "@zavx0z/space": "file:../webxr-space/space",
    "@zavx0z/template": "file:../webxr-space/template",
    "@zavx0z/ui": "file:../webxr-space/ui",
    "@zavx0z/webgpu": "file:../webxr-space/webgpu",
    "typescript": "^7.0.2"
  }
}
