{
  "name": "@zavx0z/storybook",
  "label": "Storybook",
  "version": "0.0.0",
  "private": true,
  "description": "Единый внешний сервер Storybook для независимых пакетов с декларативным описанием.",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "app",
    "route",
    "browser-lifecycle",
    "archetypes",
    "mcp/rest",
    "mcp/address",
    "mcp/children",
    "mcp/root"
  ],
  "bin": {
    "storybook": "./scripts/storybook.ts"
  },
  "scripts": {
    "storybook": "bun scripts/storybook.ts",
    "serve": "bun scripts/storybook.ts serve .",
    "build": "bun scripts/storybook.ts check .",
    "typecheck": "tsc --noEmit --pretty false",
    "browser-lifecycle:check": "bun run --cwd browser-lifecycle check",
    "route:check": "bun run --cwd route check",
    "archetypes:check": "bun test archetypes --path-ignore-patterns '**/fixture/**' --max-concurrency=1",
    "test": "STORYBOOK_SKIP_ISOLATION=1 bun test catalog discovery build sessions runtime workbench server tests src --max-concurrency=1 && bun test tests/isolation.integration.test.ts --max-concurrency=1",
    "mcp:check": "bun run --cwd mcp check",
    "check": "bun run browser-lifecycle:check && bun run typecheck && bun run route:check && bun run archetypes:check && bun run test && bun run mcp:check && bun run build"
  },
  "dependencies": {
    "@mcp/address": "workspace:*",
    "@storybook/app": "workspace:*",
    "@storybook/route": "workspace:*",
    "@mcp/rest": "workspace:*",
    "@zavx0z/storybook-browser-lifecycle": "workspace:*",
    "@mcp/children": "workspace:*",
    "@mcp/root": "workspace:*"
  },
  "devDependencies": {
    "@archetypes/specs": "workspace:archetypes/specs",
    "@immersive/headless": "workspace:../webxr-space/headless",
    "@types/bun": "^1.4.0",
    "@webgpu/types": "^0.1.68",
    "@zavx0z/browser": "workspace:../webxr-space/browser",
    "@zavx0z/component": "workspace:../webxr-space/component",
    "@zavx0z/dom": "workspace:../webxr-space/dom",
    "@zavx0z/devtools": "workspace:../webxr-space/devtools",
    "@zavx0z/engine": "workspace:../webxr-space/engine",
    "@zavx0z/highlighter": "link:@zavx0z/highlighter",
    "@nodes/layout": "workspace:../webxr-space/nodes/layout",
    "@webxr/nodes": "workspace:../webxr-space/nodes",
    "@nodes/parameters": "workspace:../webxr-space/nodes/parameters",
    "@nodes/sockets": "workspace:../webxr-space/nodes/sockets",
    "@nodes/tree": "workspace:../webxr-space/nodes/tree",
    "@renderer/html": "workspace:../webxr-space/renderer/html",
    "@zavx0z/space": "workspace:../webxr-space/space",
    "@zavx0z/template": "workspace:../webxr-space/template",
    "@zavx0z/ui": "workspace:../webxr-space/ui",
    "@zavx0z/webgpu": "workspace:../webxr-space/webgpu",
    "typescript": "^7.0.2",
    "@webxr/typedoc": "workspace:../webxr-space/typedoc",
    "@webxr/markdown": "workspace:../webxr-space/markdown",
    "@nodes/node": "workspace:../webxr-space/nodes/node"
  }
}
