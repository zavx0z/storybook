{
  "name": "@zavx0z/storybook",
  "label": "Storybook",
  "version": "0.0.0",
  "private": true,
  "description": "One external declaration-driven Storybook server for independently owned packages.",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "browser-lifecycle",
    "archetypes",
    "validator",
    "mcp/rest"
  ],
  "bin": {
    "storybook": "./scripts/storybook.ts"
  },
  "scripts": {
    "storybook": "bun scripts/storybook.ts",
    "serve": "bun scripts/storybook.ts serve .",
    "build": "bun scripts/storybook.ts check .",
    "typecheck": "tsc --noEmit --pretty false",
    "browser-lifecycle:check": "bun run --cwd browser-lifecycle check",
    "test:validator": "bun run --cwd validator test",
    "test": "STORYBOOK_SKIP_ISOLATION=1 bun test catalog discovery build sessions runtime workbench server tests src --max-concurrency=1 && bun test tests/isolation.integration.test.ts --max-concurrency=1",
    "mcp:check": "bun run --cwd mcp check",
    "check": "bun run browser-lifecycle:check && bun run typecheck && bun run test && bun run mcp:check && bun run build"
  },
  "dependencies": {
    "@mcp/rest": "workspace:*",
    "@zavx0z/storybook-browser-lifecycle": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@webgpu/types": "^0.1.68",
    "@zavx0z/browser": "file:../webxr-space/browser",
    "@zavx0z/component": "file:../webxr-space/component",
    "@zavx0z/dom": "file:../webxr-space/dom",
    "@zavx0z/devtools": "file:../webxr-space/devtools",
    "@zavx0z/engine": "file:../webxr-space/engine",
    "@zavx0z/highlighter": "link:@zavx0z/highlighter",
    "@nodes/layout": "file:../webxr-space/nodes/layout",
    "@webxr/nodes": "file:../webxr-space/nodes",
    "@nodes/parameters": "file:../webxr-space/nodes/parameters",
    "@nodes/sockets": "file:../webxr-space/nodes/sockets",
    "@nodes/tree": "file:../webxr-space/nodes/tree",
    "@renderer/html": "file:../webxr-space/renderer/html",
    "@zavx0z/space": "file:../webxr-space/space",
    "@zavx0z/template": "file:../webxr-space/template",
    "@zavx0z/ui": "file:../webxr-space/ui",
    "@zavx0z/webgpu": "file:../webxr-space/webgpu",
    "typescript": "^7.0.2",
    "@webxr/typedoc": "file:../webxr-space/typedoc",
    "@webxr/markdown": "file:../webxr-space/markdown",
    "@nodes/node": "file:../webxr-space/nodes/node"
  }
}
