{
  "name": "@zavx0z/storybook",
  "version": "0.0.0",
  "private": true,
  "description": "One external declaration-driven Storybook server for independently owned packages.",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "bin": {
    "storybook": "./scripts/storybook.ts"
  },
  "scripts": {
    "storybook": "bun scripts/storybook.ts",
    "serve": "bun scripts/storybook.ts serve .",
    "build": "bun scripts/storybook.ts check .",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "bun test src",
    "check": "bun run typecheck && bun run test && bun run build"
  },
  "devDependencies": {
    "@engine/core": "link:@engine/core",
    "@types/bun": "^1.4.0",
    "@webgpu/types": "^0.1.68",
    "@zavx0z/dom": "link:@zavx0z/dom",
    "@zavx0z/renderer": "link:@zavx0z/renderer",
    "@zavx0z/renderer-browser": "link:@zavx0z/renderer-browser",
    "@zavx0z/renderer-webgpu": "link:@zavx0z/renderer-webgpu",
    "typescript": "^7.0.2"
  }
}
