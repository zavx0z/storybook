{
  "name": "@zavx0z/storybook",
  "version": "0.0.0",
  "private": true,
  "description": "Shared private Storybook infrastructure for repository-owned development applications.",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "exports": {
    "./route-tree": "./src/route-tree.ts",
    "./stories": "./src/dom/stories.ts",
    "./catalog": "./src/dom/catalog.ts",
    "./workbench": "./src/dom/workbench.ts",
    "./references": "./src/references.ts",
    "./app": "./src/app.ts",
    "./server": "./src/server.ts",
    "./build": "./src/build.ts",
    "./environment": "./src/environment.ts",
    "./launcher": "./src/launcher.ts",
    "./scaffold": "./src/scaffold.ts"
  },
  "bin": {
    "storybook": "./scripts/storybook.ts",
    "create-storybook": "./scripts/create-storybook.ts"
  },
  "scripts": {
    "storybook": "bun app/server.ts",
    "build": "bun app/build.ts",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "bun test src",
    "test:app": "bun test app",
    "check": "bun run typecheck && bun run test && bun run test:app && bun run build"
  },
  "peerDependencies": {
    "@zavx0z/dom": "^0.1.0"
  },
  "peerDependenciesMeta": {
    "@zavx0z/dom": {"optional": true}
  },
  "devDependencies": {
    "@engine/core": "link:@engine/core",
    "@types/bun": "^1.4.0",
    "@webgpu/types": "^0.1.68",
    "@zavx0z/dom": "link:@zavx0z/dom",
    "@zavx0z/renderer": "link:@zavx0z/renderer",
    "@zavx0z/renderer-browser": "link:@zavx0z/renderer-browser",
    "@zavx0z/renderer-webgpu": "link:@zavx0z/renderer-webgpu",
    "typescript": "^7.0.2"
  }
}
