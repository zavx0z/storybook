{
  "name": "@zavx0z/storybook",
  "label": "Storybook",
  "version": "0.0.0",
  "private": true,
  "description": "Единый внешний сервер Storybook: навигация по структуре пакетов, документация и выполнение сценариев.",
  "type": "module",
  "engines": {
    "bun": "1.4.x"
  },
  "workspaces": [
    "**",
    "!**/{node_modules,spec,test,tests,fixture,fixtures,dist,projects}/**",
    "!**/.*/**"
  ],
  "scripts": {
    "storybook": "bun app/bin/zavx0z.ts",
    "serve": "bun run storybook",
    "build": "bun -e 'import createApp from \"@zavx0z/storybook-app\"\nconst context = {signal: new AbortController().signal}\nconst result = await createApp().check({schemaVersion: 1, scope: process.cwd()}, context)\nconsole.log(JSON.stringify(result, null, 2))\nif (result.status !== \"success\") process.exitCode = 1'",
    "typecheck": "bun install --cwd container/spec/fixture --frozen-lockfile --ignore-scripts && bun install --cwd cluster/spec/fixture --frozen-lockfile --ignore-scripts && tsc --noEmit --pretty false",
    "test": "bun test --no-orphans --isolate --preload @zavx0z/immersive-headless/preload ./app ./tech ./chat ./project ./repo ./package ./specs ./domain ./cluster ./component ./container ./contracts ./typedoc ./tests --max-concurrency=1 --path-ignore-patterns '{**/fixture/**,**/fixtures/**,**/isolation.integration.test.ts,**/mcp-lazy-startup.test.ts}' && bun test --no-orphans --isolate ./tests/isolation.integration.test.ts --max-concurrency=1 && bun test --isolate ./app/test/startup-reuse.test.ts",
    "check": "bun run typecheck && bun run test && bun run build",
    "subjects:check": "bun test --no-orphans --isolate --preload @zavx0z/immersive-headless/preload ./chat ./project ./repo ./package ./specs ./domain ./cluster ./component ./container ./contracts ./typedoc --path-ignore-patterns '**/{fixture,fixtures}/**' --max-concurrency=1",
    "storybook:status": "bun -e 'import createApp from \"@zavx0z/storybook-app\"\nconst context = {signal: new AbortController().signal}\nconst result = await createApp().status({schemaVersion: 1, includeViews: true}, context)\nconsole.log(JSON.stringify(result, null, 2))\nif (result.status !== \"success\") process.exitCode = 1'",
    "storybook:attach": "bun -e 'import createApp from \"@zavx0z/storybook-app\"\nconst context = {signal: new AbortController().signal}\nconst result = await createApp().attach({schemaVersion: 1, root: process.argv[1] ?? process.cwd()}, context)\nconsole.log(JSON.stringify(result, null, 2))\nif (result.status !== \"success\") process.exitCode = 1'",
    "storybook:detach": "bun -e 'import createApp from \"@zavx0z/storybook-app\"\nconst context = {signal: new AbortController().signal}\nconst result = await createApp().detach({schemaVersion: 1, scopeId: process.argv[1]}, context)\nconsole.log(JSON.stringify(result, null, 2))\nif (result.status !== \"success\") process.exitCode = 1'",
    "storybook:open": "bun -e 'import createApp from \"@zavx0z/storybook-app\"\nconst context = {signal: new AbortController().signal}\nconst result = await createApp().open({schemaVersion: 1, packageId: process.argv[1], route: process.argv[2] ?? \"\"}, context)\nconsole.log(JSON.stringify(result, null, 2))\nif (result.status !== \"success\") process.exitCode = 1'",
    "storybook:stop": "bun -e 'import createApp from \"@zavx0z/storybook-app\"\nconst context = {signal: new AbortController().signal}\nconst result = await createApp().stop({schemaVersion: 1, confirm: true}, context)\nconsole.log(JSON.stringify(result, null, 2))\nif (result.status !== \"success\") process.exitCode = 1'"
  },
  "dependencies": {
    "@zavx0z/storybook-app": "workspace:*"
  },
  "devDependencies": {
    "@zavx0z/immersive-headless": "^0.0.0",
