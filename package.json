{
  "name": "@zavx0z/storybook",
  "label": "Storybook",
  "version": "0.0.0",
  "private": true,
  "description": "Единый внешний сервер Storybook: навигация по структуре пакетов, документация и выполнение сценариев.",
  "type": "module",
  "engines": {
    "bun": "1.4.x"
  },
  "workspaces": [
    "**",
    "!**/{node_modules,spec,test,tests,fixture,fixtures,dist,projects}/**",
    "!**/.*/**"
  ],
  "bin": {
    "storybook": "./scripts/storybook.ts"
  },
  "scripts": {
    "storybook": "bun scripts/storybook.ts",
    "serve": "bun scripts/storybook.ts serve .",
    "build": "bun scripts/storybook.ts check .",
    "typecheck": "tsc --noEmit --pretty false",
    "browser-lifecycle:check": "bun run --cwd browser-lifecycle check",
    "route:check": "bun run --cwd route check",
    "archetypes:check": "bun test archetypes domain component --path-ignore-patterns '**/fixture/**' --max-concurrency=1",
    "app:check": "bun run --cwd app check",
    "test": "bun test --preload @immersive/headless/preload hmr catalog discovery build sessions runtime workbench server tests src --max-concurrency=1 --path-ignore-patterns '**/isolation.integration.test.ts' && bun test tests/isolation.integration.test.ts --max-concurrency=1",
    "mcp:check": "bun run --cwd mcp check",
    "check": "bun run browser-lifecycle:check && bun run typecheck && bun run route:check && bun run app:check && bun run archetypes:check && bun run test && bun run mcp:check && bun run build"
  },
  "dependencies": {
    "@mcp/address": "workspace:*",
    "@storybook/app": "workspace:*",
    "@storybook/route": "workspace:*",
    "@mcp/rest": "workspace:*",
    "@zavx0z/storybook-browser-lifecycle": "workspace:*",
    "@mcp/children": "workspace:*",
    "@mcp/root": "workspace:*",
    "@archetypes/package": "workspace:*",
    "@archetypes/package-documentation": "workspace:*",
    "@hmr/page": "workspace:*",
    "@hmr/activation": "workspace:*",
    "@hmr/connection": "workspace:*"
  },
  "devDependencies": {
    "@archetypes/specs": "workspace:*",
    "@immersive/headless": "^0.0.0",
    "@types/bun": "^1.4.2",
    "@webgpu/types": "^0.1.74",
    "@zavx0z/browser": "^0.0.0",
    "@zavx0z/component": "^0.0.0",
    "@zavx0z/dom": "^0.0.0",
    "@zavx0z/devtools": "^0.0.0",
    "@zavx0z/engine": "^0.0.0",
    "@zavx0z/highlighter": "^0.1.0",
    "@nodes/layout": "^0.0.0",
    "@immersive/nodes": "^0.0.0",
    "@nodes/parameters": "^0.0.0",
    "@nodes/sockets": "^0.0.0",
    "@nodes/tree": "^0.0.0",
    "@renderer/html": "^0.0.0",
    "@zavx0z/space": "^0.0.0",
    "@zavx0z/template": "^0.0.0",
    "@zavx0z/ui": "^0.0.0",
    "@zavx0z/webgpu": "^0.0.0",
    "typescript": "^7.0.2",
    "@immersive/typedoc": "^0.0.0",
    "@immersive/markdown": "^0.0.0",
    "@nodes/node": "^0.0.0",
    "@zavx0z/jsx": "^0.0.0",
    "@jsx-compiler/session": "^0.0.0",
    "@jsx-compiler/bun": "^0.0.0",
    "@jsx-runtime/create": "^0.0.0",
    "@jsx-development/create": "^0.0.0",
    "@jsx-slot/plan": "^0.0.0",
    "@jsx-slot/authoring": "^0.0.0",
    "@jsx-compiler/error": "^0.0.0",
    "@jsx/events": "^0.0.0",
    "@jsx-slot/contract": "^0.0.0",
    "@jsx-slot/child": "^0.0.0",
    "@archetypes/repo": "workspace:*",
    "@archetypes/domain": "workspace:*",
    "@archetypes/component": "workspace:*",
    "@archetypes/project": "workspace:*",
    "@archetypes/package-json": "workspace:*",
    "@archetypes/package-index": "workspace:*",
    "@archetypes/scenario-guide": "workspace:*",
    "@archetypes/scenario-validation": "workspace:*",
    "@archetypes/scenario-document": "workspace:*",
    "@jsx-runtime/fragment": "^0.0.0",
    "@jsx/runtime": "^0.0.0",
    "@jsx/development": "^0.0.0",
    "@jsx/slot": "^0.0.0",
    "@jsx/compiler": "^0.0.0"
  },
  "overrides": {
    "@immersive/headless": "link:@immersive/headless",
    "@immersive/markdown": "link:@immersive/markdown",
    "@immersive/nodes": "link:@immersive/nodes",
    "@immersive/typedoc": "link:@immersive/typedoc",
    "@jsx-compiler/bun": "link:@jsx-compiler/bun",
    "@jsx-compiler/error": "link:@jsx-compiler/error",
    "@jsx-compiler/session": "link:@jsx-compiler/session",
    "@jsx-development/create": "link:@jsx-development/create",
    "@jsx-runtime/create": "link:@jsx-runtime/create",
    "@jsx-runtime/fragment": "link:@jsx-runtime/fragment",
    "@jsx-slot/authoring": "link:@jsx-slot/authoring",
    "@jsx-slot/child": "link:@jsx-slot/child",
    "@jsx-slot/contract": "link:@jsx-slot/contract",
    "@jsx-slot/plan": "link:@jsx-slot/plan",
    "@jsx/compiler": "link:@jsx/compiler",
    "@jsx/development": "link:@jsx/development",
    "@jsx/events": "link:@jsx/events",
    "@jsx/runtime": "link:@jsx/runtime",
    "@jsx/slot": "link:@jsx/slot",
    "@nodes/layout": "link:@nodes/layout",
    "@nodes/node": "link:@nodes/node",
    "@nodes/parameters": "link:@nodes/parameters",
    "@nodes/sockets": "link:@nodes/sockets",
    "@nodes/tree": "link:@nodes/tree",
    "@renderer/html": "link:@renderer/html",
    "@zavx0z/browser": "link:@zavx0z/browser",
    "@zavx0z/component": "link:@zavx0z/component",
    "@zavx0z/devtools": "link:@zavx0z/devtools",
    "@zavx0z/dom": "link:@zavx0z/dom",
    "@zavx0z/engine": "link:@zavx0z/engine",
    "@zavx0z/highlighter": "link:@zavx0z/highlighter",
    "@zavx0z/jsx": "link:@zavx0z/jsx",
    "@zavx0z/space": "link:@zavx0z/space",
    "@zavx0z/template": "link:@zavx0z/template",
    "@zavx0z/ui": "link:@zavx0z/ui",
    "@zavx0z/webgpu": "link:@zavx0z/webgpu"
  }
}
