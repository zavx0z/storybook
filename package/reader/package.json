  "dependencies": {
    "typescript": "^7.0.2",
    "@build/compiler": "workspace:*",
    "@archetypes/package-index": "workspace:*",
    "@archetypes/package-documentation": "workspace:*",
    "@route/workspaces": "workspace:*",
    "@archetypes/package-json": "workspace:*"
  },
  "devDependencies": {
    "@package/name": "workspace:*",
    "@archetypes/contracts": "workspace:*",
    "@archetypes/domain": "workspace:*",
    "@archetypes/scenario-reader": "workspace:*"
  }
}
