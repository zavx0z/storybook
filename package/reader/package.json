{
  "name": "@storybook-package/reader",
  "label": "Пакет",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Объясняет и проверяет назначение пакета, принадлежность публичных входов и наличие их контрактов",
  "exports": {
    ".": "./index.ts"
  },
  "scripts": {
    "test:package": "bun test ./spec --test-name-pattern '^Архетип пакета(?: |$)'"
  },
  "dependencies": {
    "typescript": "^7.0.2",
    "@storybook-tech-build/compiler": "workspace:*",
    "@storybook-package/index": "workspace:*",
    "@storybook-package/documentation": "workspace:*",
    "@storybook-package-route/workspaces": "workspace:*",
    "@storybook-package/package-json": "workspace:*"
  },
  "devDependencies": {
    "@storybook-package/name": "workspace:*",
    "@storybook/contracts": "workspace:*",
    "@storybook/domain": "workspace:*",
    "@storybook-specs-scenarios/reader": "workspace:*"
  }
}
