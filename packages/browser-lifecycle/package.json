{
  "name": "@zavx0z/storybook-browser-lifecycle",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "exports": {
    "./contract": "./src/contract.ts",
    "./service": "./src/service.ts"
  },
  "scripts": {
