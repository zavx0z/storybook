import type {
  StorybookStoryArgs,
  StorybookStoryIndexItem,
  StorybookStoryModule,
  StorybookStorySource,
} from "@zavx0z/storybook/stories"
import type {StorybookStoryPanelCategory} from "@zavx0z/storybook/workbench"
import {
  loadPresentation,
  storyIndex,
  type PresentationRoute,
} from "../stories.ts"

export class StorybookLabState {
  #route: PresentationRoute
  #story: StorybookStoryIndexItem
  #module: StorybookStoryModule
  #args: StorybookStoryArgs
  #panelCategory: StorybookStoryPanelCategory = "source"
  #loadRevision = 0

  private constructor(
    route: PresentationRoute,
    story: StorybookStoryIndexItem,
    module: StorybookStoryModule,
  ) {
    this.#route = route
    this.#story = story
    this.#module = module
    this.#args = Object.freeze({...module.defaultArgs})
  }

  static async create(route: PresentationRoute): Promise<StorybookLabState> {
    return new StorybookLabState(route, storyIndex(route), await loadPresentation(route))
  }

  get route(): PresentationRoute { return this.#route }
  get story(): StorybookStoryIndexItem { return this.#story }
  get module(): StorybookStoryModule { return this.#module }
  get args(): StorybookStoryArgs { return this.#args }
  get source(): StorybookStorySource { return this.#module.source(this.#args) }
  get panelCategory(): StorybookStoryPanelCategory { return this.#panelCategory }

  async select(route: PresentationRoute): Promise<boolean> {
    const revision = ++this.#loadRevision
    const story = storyIndex(route)
    const module = await loadPresentation(route)
    if (revision !== this.#loadRevision) return false
    this.#route = route
    this.#story = story
    this.#module = module
    this.#args = Object.freeze({...module.defaultArgs})
    return true
  }

  invalidateSelection(): void {
    this.#loadRevision += 1
  }

  setControl(key: string, value: unknown): void {
    if (!this.#module.controls.some((control) => control.key === key)) {
      throw new Error(`Story не объявляет control: ${key}`)
    }
    this.#args = Object.freeze({...this.#args, [key]: value})
  }

  setPanelCategory(category: StorybookStoryPanelCategory): void {
    this.#panelCategory = category
  }
}
