import {
  defineStorybookDomCatalog,
  type StorybookDomCatalogIndexItem,
} from "@zavx0z/storybook/catalog"
import type {StorybookDomStoryModule} from "@zavx0z/storybook/stories"

export type PackageStory = StorybookDomStoryModule<Record<string, unknown>>

const loadExampleStory = async (): Promise<PackageStory> => {
  const {createExampleStory} = await import("./stories/example.ts")
  return createExampleStory()
}

export const STORIES = defineStorybookDomCatalog<PackageStory, PackageStory>({
  groups: [{
    id: "package",
    label: "Пакет",
    components: [{
      id: "example",
      label: "Первый пример",
      apiName: "__PACKAGE_NAME__",
      tags: ["starter", "fixture", "package"],
      sections: [{
        id: "overview",
        label: "Обзор",
        variants: [{
          id: "default",
          label: "Основной",
          title: "__APP_TITLE__ · Первый пример",
          load: loadExampleStory,
        }],
      }],
    }],
  }],
  representative: {component: "example", section: "overview", variant: "default"},
  normalizeModule(route, loaded) {
    if (
      typeof loaded !== "object" ||
      loaded === null ||
      typeof loaded.render !== "function" ||
      typeof loaded.source !== "function"
    ) throw new Error(`Некорректная DOM story __APP_TITLE__: ${route}`)
    return loaded
  },
})

export function storyContext(route: string): StorybookDomCatalogIndexItem | null {
  const exact = STORIES.find(route)
  if (exact !== undefined) return exact
  const prefix = route.length === 0 ? "" : `${route}/`
  return STORIES.index.find(({route: leaf}) => (
    prefix.length === 0 || leaf.startsWith(prefix)
  )) ?? null
}
