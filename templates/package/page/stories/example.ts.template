import {CodeEditor} from "@ui/components/code-editor"
import {Typography} from "@ui/components/typography"
import {defineStorybookStoryModule} from "@zavx0z/storybook/stories"
import {EXAMPLE_FIXTURE} from "../fixtures/example.ts"

export function createExampleStory() {
  return defineStorybookStoryModule({
    defaultArgs: {"show-values": true},
    controls: [{
      key: "show-values",
      label: "Показывать values",
      group: "Пример",
      kind: "boolean",
    }],
    render(surface, args, frame) {
      const inset = 18
      Typography(surface, frame.x + inset, frame.y + 52, Math.max(1, frame.w - inset * 2), 28, {
        children: EXAMPLE_FIXTURE.message,
        variant: "subtitle",
      })
      CodeEditor(
        surface,
        frame.x + inset,
        frame.y + 88,
        Math.max(1, frame.w - inset * 2),
        Math.max(1, frame.h - 106),
        {
          key: "starter-fixture",
          value: JSON.stringify({
            packageName: EXAMPLE_FIXTURE.packageName,
            ...(args["show-values"] === true ? {values: EXAMPLE_FIXTURE.values} : {}),
          }, null, 2),
          readOnly: true,
          languageId: "json",
          showLineNumbers: true,
        },
      )
    },
    source(args) {
      return {
        html: `<article class="fixture"${args["show-values"] === true ? ` data-values="${EXAMPLE_FIXTURE.values.join(",")}"` : ""}>
  <h2 class="fixture__message">${EXAMPLE_FIXTURE.message}</h2>
  <pre class="fixture__data"></pre>
</article>`,
        css: `.fixture {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100%;
  gap: 12px;
  padding: 18px;
  border: 1px solid #1a1a1a;
  border-radius: 6px;
  color: #e8e8e8;
  background: #303030;
}

.fixture__message {
  margin: 0;
  font-size: 16px;
  line-height: 28px;
}

.fixture__data {
  flex: 1 1 auto;
  margin: 0;
  overflow: auto;
}`,
        typescript: `import {EXAMPLE_FIXTURE} from "./fixtures/example.ts"

const visible = ${args["show-values"] === true ? "EXAMPLE_FIXTURE.values" : "EXAMPLE_FIXTURE.message"}`,
      }
    },
  })
}
