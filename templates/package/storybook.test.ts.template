import {describe, expect, test} from "bun:test"
import {createStorybookApp} from "./app.ts"
import {STORIES} from "./page/stories.ts"

describe("__PACKAGE_NAME__ scaffold", () => {
  test("owns one typed Workbench page and one lazy starter story", async () => {
    const app = createStorybookApp()
    expect(app.id).toBe("__APP_ID__")
    expect(app.pages).toHaveLength(1)
    expect(app.pages[0]?.routeTree).toBe(STORIES.routeTree)
    expect(STORIES.routeTree.leaves).toEqual(["example/overview/default"])
    const story = await STORIES.load("example/overview/default")
    expect(story.source(story.defaultArgs)).toContain("EXAMPLE_FIXTURE")
  })

  test("uses an automatic-port package server without consumer port knowledge", async () => {
    const source = await Bun.file(new URL("./server.ts", import.meta.url)).text()
    expect(source).toContain("startStorybookPackageServer")
    expect(source).not.toContain("port:")
    expect(source).not.toMatch(/_STORYBOOK_PORT/u)
  })
})
