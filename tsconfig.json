{
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "dom.iterable"],
    "types": ["@webgpu/types", "bun"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "@zavx0z/template",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true
  },
  "include": [
    "validator/**/*.ts",
    "archetypes/**/*.ts",
    "archetypes/**/*.tsx",
    "catalog/**/*.ts",
    "discovery/**/*.ts",
    "build/**/*.ts",
    "sessions/**/*.ts",
    "runtime/**/*.ts",
    "runtime/**/*.tsx",
    "workbench/**/*.ts",
    "workbench/**/*.tsx",
    "server/**/*.ts",
    "tests/**/*.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "scripts/**/*.ts",
    ".agents/hooks/**/*.ts",
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx"
  ],
  "exclude": ["dist", "node_modules", ".refactor-audit"]
}
